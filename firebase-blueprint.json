    "CloudGameSave": {
      "title": "CloudGameSave",
      "description": "Cross-device cloud save state with monotonic version counter for conflict resolution.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "version": {
          "type": "number",
          "description": "Monotonically increasing save revision to prevent older local saves overwriting newer cloud saves."
        },
        "clientUpdatedAtMs": {
          "type": "number"
        },
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "saveData": {
          "type": "object"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "version", "clientUpdatedAtMs", "deviceId", "saveData", "updatedAt"]
    },
    "OwnerRoleGrant": {
      "title": "OwnerRoleGrant",
      "description": "Verified Apex Syndicate owner role record granted only when verified email is kchiboy50@gmail.com and username is chiboy_52.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 120
        },
        "usernameLower": {
          "type": "string",
          "maxLength": 24
        },
        "role": {
          "type": "string",
          "enum": ["owner"]
        },
        "grantedBy": {
          "type": "string",
          "maxLength": 64
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "usernameLower", "role", "grantedBy", "grantedAt"]
    },
    "OwnerAuditLog": {
      "title": "OwnerAuditLog",
      "description": "Immutable audit log of privileged Apex Syndicate owner actions.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "actorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "actorEmail": {
          "type": "string",
          "maxLength": 120
        },
        "action": {
          "type": "string",
          "enum": ["PROVISION_OWNER", "VIEW_REGISTRY", "VIEW_ACCOUNT", "SUSPEND_ACCOUNT", "RESTORE_ACCOUNT", "GLOBAL_SYNC", "NEPA_OVERRIDE", "BROADCAST_AUDIO"]
        },
        "targetUid": {
          "type": "string",
          "maxLength": 128
        },
        "targetUsername": {
          "type": "string",
          "maxLength": 48
        },
        "details": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "actorUid", "actorEmail", "action", "details", "createdAt"]
    },
    "GlobalBroadcast": {
      "title": "GlobalBroadcast",
      "description": "Active owner-uploaded server-wide background music metadata.",
      "type": "object",
      "properties": {
        "trackId": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 160 },
        "mimeType": { "type": "string", "maxLength": 64 },
        "sizeBytes": { "type": "number" },
        "totalChunks": { "type": "number" },
        "uploadedBy": { "type": "string", "maxLength": 32 },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["trackId", "title", "mimeType", "sizeBytes", "totalChunks", "uploadedBy", "active", "updatedAt"]
    },
    "BroadcastChunk": {
      "title": "BroadcastChunk",
      "description": "Base64 audio chunk slice under 750KB for cross-server broadcast playback.",
      "type": "object",
      "properties": {
        "trackId": { "type": "string", "maxLength": 64 },
        "chunkIndex": { "type": "number" },
        "chunkData": { "type": "string", "maxLength": 750000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["trackId", "chunkIndex", "chunkData", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Core non-PII user account records keyed by Firebase Auth UID."
    },
    "/users_private/{uid}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Private PII (email, date of birth) strictly accessible by owner of uid or verified Apex Syndicate Owner."
    },
    "/usernames/{usernameLower}": {
      "schema": { "$ref": "#/entities/UsernameReservation" },
      "description": "Unique lowercase username registry mapping to uid."
    },
    "/profiles/{uid}": {
      "schema": { "$ref": "#/entities/CitizenProfile" },
      "description": "Synchronized Naija Life citizen profile, avatar, wallet, and game stats."
    },
    "/game_saves/{uid}": {
      "schema": { "$ref": "#/entities/CloudGameSave" },
      "description": "Versioned cross-device cloud game save document."
    },
    "/owner_roles/{uid}": {
      "schema": { "$ref": "#/entities/OwnerRoleGrant" },
      "description": "Trusted owner role record restricted strictly to verified kchiboy50@gmail.com with username chiboy_52."
    },
    "/owner_audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/OwnerAuditLog" },
      "description": "Immutable append-only audit logs for Apex Syndicate owner actions."
    },
    "/global_state/{docId}": {
      "schema": { "$ref": "#/entities/GlobalBroadcast" },
      "description": "Server-wide broadcast soundtrack control metadata."
    },
    "/broadcast_chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/BroadcastChunk" },
      "description": "Chunked MP3 broadcast slices for cross-server audio playback."
    }
  }
}
